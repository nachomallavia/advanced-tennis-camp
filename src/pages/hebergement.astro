---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Button } from '@/components/starwind/button';
import { Image } from 'astro:assets';
import { CldImage } from 'astro-cloudinary';
import { getCollection } from 'astro:content';
import { Carousel, CarouselContent, CarouselItem } from '@/components/starwind/carousel';

const accomodation = await getCollection('accomodation');
const family = accomodation.filter((item) => item.data.tags?.includes('family'));
const kids = accomodation.filter((item) => item.data.tags?.includes('kids'));

const title = "Hébergement - Advanced Tennis Camp";
const description = "Hébergement pour familles et enfants à Verbier. Family pack en partenariat avec le Chalet d'Adrien et chalets pour les enfants.";
---

<BaseLayout title={title} description={description}>
  <section class="py-12 bg-white">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl md:text-5xl font-bold text-primary mb-12">
        HÉBERGEMENT
      </h1>
      
      <div class="grid lg:grid-cols-2 gap-12">
        <!-- Family Pack Section -->
        <div class="flex flex-col justify-between items-center">
          <div class="prose prose-lg max-w-none mb-8">
            <h2 class="text-2xl font-bold text-primary mb-4">Family pack</h2>
            <p>
              <strong>Mis en place pour la première en fois en 2018, nous proposons aux familles de profiter de la montagne en « toute liberté ».</strong> En partenariat avec le Chalet d'Adrien, l'équipe de l'Advanced Tennis Camp s'occupe de votre séjour sportif et de celui de vos enfants.
            </p>
            <p>
              Jouer au tennis, visiter la région en E-Bike, découvrez les sentiers de Verbier, prenez soin de vous; dans un cadre verdoyant, majestueux, nous ferons en sorte que votre séjour soit inoubliable!!
            </p>
            <p>
              Tout sur <em><strong>Le Chalet d'Adrien – Le Charme et l'Authenticité Moments uniques à Verbier</strong></em> <a href="https://chalet-adrien.com/" target="_blank" rel="noopener" class="text-primary font-bold hover:underline">cliquez ici !</a>
            </p>
          </div>
          
          <!-- Family Carousel -->
          {family.length > 0 ? (
            <div class="relative mb-8 w-full" data-accom-carousel="family-carousel">
              <Carousel
                id="family-carousel"
                class="w-full"
                opts={{ loop: true }}
                autoInit={false}
              >
                <CarouselContent>
                  {family.map((img) => (
                    <CarouselItem>
                      <CldImage
                        src={img.id}
                        alt={img.data.context?.custom?.alt || "Family accommodation"}
                        width={800}
                        height={600}
                        class="w-full h-[400px] object-cover rounded-xs"
                      />
                    </CarouselItem>
                  ))}
                </CarouselContent>
              </Carousel>
              <div class="flex items-center justify-center gap-4 mt-3">
                <button type="button" class="accom-prev size-8 rounded-full border border-neutral-300 bg-white hover:bg-neutral-100 flex items-center justify-center transition-colors" aria-label="Diapositive précédente">
                  <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                </button>
                <div class="flex justify-center gap-2" data-carousel-dots="family-carousel">
                  {family.map((_, index) => (
                    <button type="button" class="w-2 h-2 rounded-full bg-gray-300 hover:bg-primary transition-colors duration-200 dot" data-index={index} aria-label={`Aller à la diapositive ${index + 1}`} />
                  ))}
                </div>
                <button type="button" class="accom-next size-8 rounded-full border border-neutral-300 bg-white hover:bg-neutral-100 flex items-center justify-center transition-colors" aria-label="Diapositive suivante">
                  <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                </button>
              </div>
            </div>
          ) : (
            <p class="text-gray-500">No family images available</p>
          )}
        </div>
        
        <!-- Kids Section -->
        <div class="flex flex-col justify-between items-center">
          <div class="prose prose-lg max-w-none mb-8">
            <h2 class="text-2xl font-bold text-primary mb-4">Enfants</h2>
            <p>
              <strong>Deux chalets sont à notre disposition pour accueillir et loger vos enfants durant leur séjour tennistique à Verbier.</strong> Nos coachs seront bien entendu répartis pour être présents dans les deux chalets afin que vos enfants ne soient jamais seuls. <strong>Nous disposons de chambres simples, doubles, ou triples dans un environnement classique de montagne, de pleine nature qui rendra ce camp inoubliable.</strong>
            </p>
          </div>
          
          <!-- Kids Carousel -->
          {kids.length > 0 ? (
            <div class="relative mb-8 w-full" data-accom-carousel="kids-carousel">
              <Carousel
                id="kids-carousel"
                class="w-full"
                opts={{ loop: true }}
                autoInit={false}
              >
                <CarouselContent>
                  {kids.map((img) => (
                    <CarouselItem>
                      <CldImage
                        src={img.id}
                        alt={img.data.context?.custom?.alt || "Kids accommodation"}
                        width={800}
                        height={600}
                        class="w-full h-[400px] object-cover rounded-xs"
                      />
                    </CarouselItem>
                  ))}
                </CarouselContent>
              </Carousel>
              <div class="flex items-center justify-center gap-4 mt-3">
                <button type="button" class="accom-prev size-8 rounded-full border border-neutral-300 bg-white hover:bg-neutral-100 flex items-center justify-center transition-colors" aria-label="Diapositive précédente">
                  <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                </button>
                <div class="flex justify-center gap-2" data-carousel-dots="kids-carousel">
                  {kids.map((_, index) => (
                    <button type="button" class="w-2 h-2 rounded-full bg-gray-300 hover:bg-primary transition-colors duration-200 dot" data-index={index} aria-label={`Aller à la diapositive ${index + 1}`} />
                  ))}
                </div>
                <button type="button" class="accom-next size-8 rounded-full border border-neutral-300 bg-white hover:bg-neutral-100 flex items-center justify-center transition-colors" aria-label="Diapositive suivante">
                  <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                </button>
              </div>
            </div>
          ) : (
            <p class="text-gray-500">No kids images available</p>
          )}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initCarousel } from '@/components/starwind/carousel';

  const setupCarousels = () => {
    document.querySelectorAll<HTMLElement>('[data-accom-carousel]').forEach((wrapper) => {
      const carouselId = wrapper.dataset.accomCarousel;
      if (!carouselId) return;

      const carousel = document.getElementById(carouselId);
      if (!carousel || carousel.dataset.initialized === 'true') return;

      const manager = initCarousel(carousel);
      if (!manager) return;

      // Arrows
      const prevBtn = wrapper.querySelector<HTMLButtonElement>('.accom-prev');
      const nextBtn = wrapper.querySelector<HTMLButtonElement>('.accom-next');
      prevBtn?.addEventListener('click', () => manager.api.scrollPrev());
      nextBtn?.addEventListener('click', () => manager.api.scrollNext());

      // Dots
      const dotsContainer = wrapper.querySelector<HTMLElement>('[data-carousel-dots]');
      if (dotsContainer) {
        const dots = dotsContainer.querySelectorAll<HTMLElement>('.dot');

        const updateDots = () => {
          const selected = manager.api.selectedScrollSnap();
          dots.forEach((dot, i) => {
            dot.classList.toggle('bg-primary', i === selected);
            dot.classList.toggle('bg-gray-300', i !== selected);
          });
        };

        dots.forEach((dot) => {
          dot.addEventListener('click', () => {
            manager.api.scrollTo(parseInt(dot.dataset.index ?? '0', 10));
          });
        });

        manager.api.on('select', updateDots);
        manager.api.on('init', updateDots);
        updateDots();
      }
    });
  };

  document.addEventListener('DOMContentLoaded', setupCarousels);
  document.addEventListener('astro:after-swap', setupCarousels);
</script>
