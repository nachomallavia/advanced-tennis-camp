---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Button } from '@/components/starwind/button';
import CampHero from '@/components/sections/CampHero.astro';
import Hero from '@/components/sections/Hero.astro';
import SingleFeature from '@/components/sections/SingleFeature.astro';
import golfPlayImg from '@/assets/images/select/P1000261.avif';
import logoGolf from '@/assets/images/logos/logo-golf.png';
import { Image } from 'astro:assets';
const title = "Golf+Play - Advanced Tennis Camp";
const description = "Deux sports de balle, deux jeux qui font appel à la stratégie et à la gestion de ses émotions. Programme combinant golf et tennis à Verbier.";
---

<BaseLayout title={title} description={description} transparentHeader={true}>
  <!-- <CampHero
    title="GOLF + PLAY"
    subtitle="Deux sports de balle, deux jeux de stratégie et d'émotions"
    buttonText="CONTACT & INSCRIPTIONS"
    buttonLink="/contact/"
    heroImage={golfPlayImg}
    secondaryImage={logoGolf}
    secondaryImageAlt="Verbier Golf Club"
  >
    
  </CampHero> -->
  <Hero
      title="GOLF + PLAY"
      tagline="Deux sports de balle, deux jeux de stratégie et d'émotions"

      sponsorLogo={logoGolf}
      videoSrc="https://res.cloudinary.com/duykgwmak/video/upload/ac_none,br_1600k,vc_auto/v1768223935/Extra_tennis_Golf_hxgggf.webm"
    />
    <SingleFeature
      headline="GOLF + PLAY"
      tagline="Deux sports de balle, deux jeux de stratégie et d'émotions"
      primaryButtonText="CONTACT & INSCRIPTIONS"
      primaryButtonHref="/contact/"
      showCTAs={false}
      class="py-20"
    >
    <Image slot="image" src={golfPlayImg} alt="Golf+Play" class="rounded-xs" />
    <p>
      <strong>Première édition du programme en 2019 !!!</strong><br />
      Deux sports de balle, deux jeux qui font appel à la stratégie et à la gestion de ses émotions. Quoi de plus naturel de les associer !!
    </p>
    
    <p>
      C'est <strong>Mike Coppens et son TEAM</strong> qui accompagneront vos enfants tout au long de la semaine. Ceux qui connaissent Mike savent qu'ils sont entre de « bonnes mains » !
    </p><br>
    
    <h3 class="text-xl font-bold text-primary mt-8 mb-4">PROGRAMME</h3>
    <ul class="space-y-2">
      <li>Rendez-vous tous les matins au <strong>Parc des Loisirs à 9h00 pour démarrer la journée avant de rejoindre Mike</strong></li>
      <li><strong>12h00</strong> retour Time OUT pour le déjeuner</li>
      <li><strong>13h45</strong> début du programme Golf</li>
      <li><strong>16h15 retour sur les courts pour terminer la journée.</strong></li>
    </ul>
    
    <p class="mt-4">
      Remise des prix et des diplomes <strong>le samedi dès 11H30</strong> sur la terrasse du Chalet d'Adrien.
    </p>
    </SingleFeature>
  
  
  <!-- Program Details Section -->
  <section class="py-12 bg-neutral-200">
    <div class="container mx-auto px-4">
      <div class="max-w-2xl mx-auto">
        <div class="bg-white rounded-sm shadow-sm p-8">
          <h4 class="text-2xl font-bold text-primary mb-6">ENFANTS NÉS EN 2017-2012</h4>
          <ul class="space-y-3 text-neutral-700 mb-6">
            <li><strong>Lundi :</strong> Driving-Range pour évaluer le niveau</li>
            <li><strong>Mardi :</strong> Petit jeu, approches-puts</li>
            <li><strong>Mercredi :</strong> Jeu sur le parcours, vidéo</li>
            <li><strong>Jeudi</strong> : Petit jeu, approches-puts/Compétition aux Moulins</li>
            <li><strong>Vendredi :</strong> Driving –Range, les « Bois »</li>
          </ul>
          <p class="text-xl font-bold text-primary mb-6">Prix: 1190 CHF</p>
          <Button href="/contact/" variant="primary">
            CONTACT & INSCRIPTIONS
          </Button>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Disclaimer -->
  <section class="py-8 bg-white">
    <div class="container mx-auto px-4">
      <p class="text-sm text-neutral-600 italic">
        * Le prix comprend les balles au driving-range, les accès sur le parcours, la demie-pension. Minimum deux personnes pour avoir lieu. Possibilité de louer du matériel, en supplément.
      </p>
    </div>
  </section>
</BaseLayout>
