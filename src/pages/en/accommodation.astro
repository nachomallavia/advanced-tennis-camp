---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Button } from '@/components/starwind/button';
import { Image } from 'astro:assets';
import { CldImage } from 'astro-cloudinary';
import { getCollection } from 'astro:content';
import { Carousel, CarouselContent, CarouselItem } from '@/components/starwind/carousel';

const accomodation = await getCollection('accomodation');
const family = accomodation.filter((item) => item.data.tags?.includes('family'));
const kids = accomodation.filter((item) => item.data.tags?.includes('kids'));

const title = "Accommodation - Advanced Tennis Camp";
const description = "Accommodation for families and children in Verbier. Family pack in partnership with Chalet d'Adrien and chalets for kids.";
---

<BaseLayout title={title} description={description}>
  <section class="py-12 bg-white">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl md:text-5xl font-bold text-primary mb-12">
        Accomodation
      </h1>
      
      <div class="grid lg:grid-cols-2 gap-12">
        <!-- Family Pack Section -->
        <div class="flex flex-col justify-between items-center">
          <div class="prose prose-lg max-w-none mb-8">
            <h2 class="text-2xl font-bold text-primary mb-4">Family pack</h2>
            <p>
              <strong>Since 2018, we suggested to the families taking advantage of the mountain in 'any freedom'.</strong> In partnership with Chalet d'Adrien the team at Advanced Tennis Camp will take care of your sports stay as well as that of your children.
            </p>
            <p>
              Playing tennis, exploring the region on E-Bike, discovering the walking paths of Verbier – we'll take care of you. The green and majestic mountain settings of Verbier will make for an unforgettable stay!
            </p>
            <p>
              All about Le Chalet d'Adrien – Charme & Prestige in Verbier, <a href="https://chalet-adrien.com/en/" target="_blank" rel="noopener" class="text-primary font-bold hover:underline">click here !</a>
            </p>
          </div>
          
          <!-- Family Carousel -->
          {family.length > 0 ? (
            <div class="relative mb-8 w-full" data-accom-carousel="family-carousel">
              <Carousel
                id="family-carousel"
                class="w-full"
                opts={{ loop: true }}
                autoInit={false}
              >
                <CarouselContent>
                  {family.map((img) => (
                    <CarouselItem>
                      <CldImage
                        src={img.id}
                        alt={img.data.context?.custom?.alt || "Family accommodation"}
                        width={800}
                        height={600}
                        class="w-full h-[400px] object-cover rounded-xs"
                      />
                    </CarouselItem>
                  ))}
                </CarouselContent>
              </Carousel>
              <div class="flex items-center justify-center gap-4 mt-3">
                <button type="button" class="accom-prev size-8 rounded-full border border-neutral-300 bg-white hover:bg-neutral-100 flex items-center justify-center transition-colors" aria-label="Previous slide">
                  <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                </button>
                <div class="flex justify-center gap-2" data-carousel-dots="family-carousel">
                  {family.map((_, index) => (
                    <button type="button" class="w-2 h-2 rounded-full bg-gray-300 hover:bg-primary transition-colors duration-200 dot" data-index={index} aria-label={`Go to slide ${index + 1}`} />
                  ))}
                </div>
                <button type="button" class="accom-next size-8 rounded-full border border-neutral-300 bg-white hover:bg-neutral-100 flex items-center justify-center transition-colors" aria-label="Next slide">
                  <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                </button>
              </div>
            </div>
          ) : (
            <p class="text-gray-500">No family images available</p>
          )}
        </div>
        
        <!-- Kids Section -->
        <div class="flex flex-col justify-between items-center">
          <div class="prose prose-lg max-w-none mb-8">
            <h2 class="text-2xl font-bold text-primary mb-4">"Kids"</h2>
            <p>
              <strong>During your children's stay in Verbier we will comfortably accomodate them in these two chalets</strong>. The team of coaches/trainers will ensure both chalets are used to their best arrangment to ensure your children will not stay alone. <strong>We provide single, double or triple rooms in a classical mountain atmosphere.</strong>
            </p>
          </div>
          
          <!-- Kids Carousel -->
          {kids.length > 0 ? (
            <div class="relative mb-8 w-full" data-accom-carousel="kids-carousel">
              <Carousel
                id="kids-carousel"
                class="w-full"
                opts={{ loop: true }}
                autoInit={false}
              >
                <CarouselContent>
                  {kids.map((img) => (
                    <CarouselItem>
                      <CldImage
                        src={img.id}
                        alt={img.data.context?.custom?.alt || "Kids accommodation"}
                        width={800}
                        height={600}
                        class="w-full h-[400px] object-cover rounded-xs"
                      />
                    </CarouselItem>
                  ))}
                </CarouselContent>
              </Carousel>
              <div class="flex items-center justify-center gap-4 mt-3">
                <button type="button" class="accom-prev size-8 rounded-full border border-neutral-300 bg-white hover:bg-neutral-100 flex items-center justify-center transition-colors" aria-label="Previous slide">
                  <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                </button>
                <div class="flex justify-center gap-2" data-carousel-dots="kids-carousel">
                  {kids.map((_, index) => (
                    <button type="button" class="w-2 h-2 rounded-full bg-gray-300 hover:bg-primary transition-colors duration-200 dot" data-index={index} aria-label={`Go to slide ${index + 1}`} />
                  ))}
                </div>
                <button type="button" class="accom-next size-8 rounded-full border border-neutral-300 bg-white hover:bg-neutral-100 flex items-center justify-center transition-colors" aria-label="Next slide">
                  <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                </button>
              </div>
            </div>
          ) : (
            <p class="text-gray-500">No kids images available</p>
          )}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initCarousel } from '@/components/starwind/carousel';

  const setupCarousels = () => {
    document.querySelectorAll<HTMLElement>('[data-accom-carousel]').forEach((wrapper) => {
      const carouselId = wrapper.dataset.accomCarousel;
      if (!carouselId) return;

      const carousel = document.getElementById(carouselId);
      if (!carousel || carousel.dataset.initialized === 'true') return;

      const manager = initCarousel(carousel);
      if (!manager) return;

      // Arrows
      const prevBtn = wrapper.querySelector<HTMLButtonElement>('.accom-prev');
      const nextBtn = wrapper.querySelector<HTMLButtonElement>('.accom-next');
      prevBtn?.addEventListener('click', () => manager.api.scrollPrev());
      nextBtn?.addEventListener('click', () => manager.api.scrollNext());

      // Dots
      const dotsContainer = wrapper.querySelector<HTMLElement>('[data-carousel-dots]');
      if (dotsContainer) {
        const dots = dotsContainer.querySelectorAll<HTMLElement>('.dot');

        const updateDots = () => {
          const selected = manager.api.selectedScrollSnap();
          dots.forEach((dot, i) => {
            dot.classList.toggle('bg-primary', i === selected);
            dot.classList.toggle('bg-gray-300', i !== selected);
          });
        };

        dots.forEach((dot) => {
          dot.addEventListener('click', () => {
            manager.api.scrollTo(parseInt(dot.dataset.index ?? '0', 10));
          });
        });

        manager.api.on('select', updateDots);
        manager.api.on('init', updateDots);
        updateDots();
      }
    });
  };

  document.addEventListener('DOMContentLoaded', setupCarousels);
  document.addEventListener('astro:after-swap', setupCarousels);
</script>
