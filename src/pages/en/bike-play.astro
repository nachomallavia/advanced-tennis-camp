---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Button } from '@/components/starwind/button';
import CampHero from '@/components/sections/CampHero.astro';
import Hero from '@/components/sections/Hero.astro';
import bikePlayImg from '@/assets/images/select/WhatsApp-Image-2022-07-21-at-11.37.32.avif';
import logoEssV from '@/assets/images/logos/ESS_verbier-300x300.png';
import SingleFeature from '@/components/sections/SingleFeature.astro';
import { Image } from 'astro:assets';

const title = "BIKE + PLAY - Advanced Tennis Camp";
const description = "Camp combining cycling and tennis for children aged 7 and above. BMX, mountain bike enduro, downhill MTB, Skateboard in Verbier.";
---

<BaseLayout title={title} description={description} transparentHeader={true}>
  <!-- <CampHero
    title="BIKE + PLAY"
    subtitle="in collaboration with Verbier Swiss Ski School"
    buttonText="CONTACT & BOOKINGS"
    buttonLink="/en/contact/"
    heroImage={bikePlayImg}
    secondaryImage={logoEssV}
    secondaryImageAlt="ESS Verbier"
  > -->
    <Hero
      title="BIKE + PLAY"
      tagline="in collaboration with Verbier Swiss Ski School"

      sponsorLogo={logoEssV}
      videoSrc="https://res.cloudinary.com/duykgwmak/video/upload/ac_none,br_1600k,vc_auto/v1768223981/Extra_tennis_bike_ngnjjo.webm"
    />
    <SingleFeature
      headline="BIKE + PLAY"
      tagline="in collaboration with Verbier Swiss Ski School"
      primaryButtonText="CONTACT & BOOKINGS"
      primaryButtonHref="/en/contact/"
      showCTAs={false}
      class="py-20"
    >
    <Image slot="image" src={bikePlayImg} alt="Bike+Play" class="rounded-xs" />
      <p>
        <strong>For the first time in 2018,</strong> the Advanced Tennis Camp have set up a camp combining cycling and tennis.<strong> For children aged 7 and above,</strong> the 'Bike+Play' camp is designed to allow youngsters to discover the mountain.</p> <br>
        <p>Throughout the week in the mornings, children will be allowed to practice different forms of cycling including <strong>BMX, mountain bike enduro and mountain bike downhill. Skateboarding will also be available.</strong>
      </p><br>
      <p>
        <strong>Professionals in each discipline</strong> will accompany the youngsters to ensure their safety before joining the ATC team to 'play' tennis in the beautiful setting of Verbier.
      </p><br>
      <p>
        <strong>Groups of 4 people maximum per age group.</strong>
      </p><br>
    </SingleFeature>
    
  
  <!-- Age Groups Section -->
  <section class="py-12 bg-neutral-200">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-8">
        <!-- 7-10 y.o. -->
        <div class="bg-white rounded-sm shadow-sm p-8">
          <h4 class="text-2xl font-bold text-primary mb-6">7-10 y.o. (2019-2016)</h4>
          <ul class="space-y-3 text-neutral-700 mb-6">
            <li><strong>Monday:</strong> BMX – Mountain Bike – introduction (morning) / Tennis (afternoon)</li>
            <li><strong>Tuesday:</strong> BMX – Mountain Bike – introduction (morning) / Tennis (afternoon)</li>
            <li><strong>Wednesday:</strong> Mountain bike – trails (morning) / Tennis (afternoon)</li>
            <li><strong>Thursday:</strong> Mountain Bike (morning) / Tennis (afternoon)</li>
            <li><strong>Friday:</strong> Mountain Bike (morning) / Tennis (afternoon)</li>
          </ul>
          <p class="text-xl font-bold text-primary mb-6">Price: CHF 1350 per person</p>
          <Button href="/en/contact/" variant="primary">
            CONTACT & BOOKINGS
          </Button>
        </div>
        
        <!-- 11-15 y.o. -->
        <div class="bg-white rounded-sm shadow-sm p-8">
          <h4 class="text-2xl font-bold text-primary mb-6">11-15 y.o. (2015-2011)</h4>
          <ul class="space-y-3 text-neutral-700 mb-6">
            <li><strong>Monday:</strong> BMX – Mountain Bike – introduction (morning) / Tennis (afternoon)</li>
            <li><strong>Tuesday:</strong> BMX – Mountain Bike – Track (morning) / Tennis (afternoon)</li>
            <li><strong>Wednesday:</strong> Mountain bike – trails (morning) / Tennis (afternoon)</li>
            <li><strong>Thursday:</strong> Mountain Bike Enduro (morning) / Tennis (afternoon)</li>
            <li><strong>Friday:</strong> Mountain Bike downhill (morning) / Tennis (afternoon)</li>
          </ul>
          <p class="text-xl font-bold text-primary mb-6">Price: CHF 1450 per person</p>
          <Button href="/en/contact/" variant="primary">
            CONTACT & BOOKINGS
          </Button>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Disclaimer -->
  <section class="py-8 bg-white">
    <div class="container mx-auto px-4">
      <p class="text-sm text-neutral-600 italic">
        *Prices are inclusive of bike hire, protection, lifts pass and half-board accomodation. In order to take place, a minimum of 2 children are required to sign onto the course. All classes are supervised by professionals from Kids Bike League. Classes take place at FunPark du Chable, La Gouille in Vaudan for BMX, BikePark Verbier, Savoleyres or at Chez Martin with obstacles set.
      </p>
    </div>
  </section>
</BaseLayout>
