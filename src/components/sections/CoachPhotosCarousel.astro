---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { Carousel, CarouselContent, CarouselItem } from '@/components/starwind/carousel';

interface Props {
  images: { src: ImageMetadata; alt: string }[];
  carouselId?: string;
}

const { images, carouselId = 'coach-carousel' } = Astro.props;
---

<div class="relative" data-coach-carousel={carouselId}>
  <Carousel
    id={carouselId}
    class="w-full"
    opts={{ loop: true }}
    autoInit={false}
  >
    <CarouselContent>
      {images.map((img) => (
        <CarouselItem>
          <Image
            src={img.src}
            alt={img.alt}
            class="w-full h-[400px] md:h-[500px] object-cover rounded-xs"
          />
        </CarouselItem>
      ))}
    </CarouselContent>
  </Carousel>

  <!-- Controls: prev · dots · next — all in normal flow below the image -->
  <div class="flex items-center justify-center gap-4 mt-3">
    <button
      type="button"
      class="carousel-prev size-8 rounded-full border border-neutral-300 bg-white hover:bg-neutral-100 flex items-center justify-center transition-colors"
      aria-label="Previous slide"
    >
      <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <div class="flex gap-2" data-carousel-dots={carouselId}>
      {images.map((_, index) => (
        <button
          type="button"
          class="w-2 h-2 rounded-full bg-gray-300 hover:bg-primary transition-colors dot"
          data-index={index}
          aria-label={`Slide ${index + 1}`}
        />
      ))}
    </div>

    <button
      type="button"
      class="carousel-next size-8 rounded-full border border-neutral-300 bg-white hover:bg-neutral-100 flex items-center justify-center transition-colors"
      aria-label="Next slide"
    >
      <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </button>
  </div>
</div>

<script>
  import { initCarousel } from '@/components/starwind/carousel';

  const setupCarousels = () => {
    document.querySelectorAll<HTMLElement>('[data-coach-carousel]').forEach((wrapper) => {
      const carouselId = wrapper.dataset.coachCarousel;
      if (!carouselId) return;

      const carousel = document.getElementById(carouselId);
      if (!carousel || carousel.dataset.initialized === 'true') return;

      const manager = initCarousel(carousel);
      if (!manager) return;

      // Prev / Next
      const prevBtn = wrapper.querySelector<HTMLButtonElement>('.carousel-prev');
      const nextBtn = wrapper.querySelector<HTMLButtonElement>('.carousel-next');
      prevBtn?.addEventListener('click', () => manager.api.scrollPrev());
      nextBtn?.addEventListener('click', () => manager.api.scrollNext());

      // Dots
      const dotsContainer = wrapper.querySelector<HTMLElement>('[data-carousel-dots]');
      if (dotsContainer) {
        const dots = dotsContainer.querySelectorAll<HTMLElement>('.dot');

        const updateDots = () => {
          const selected = manager.api.selectedScrollSnap();
          dots.forEach((dot, i) => {
            dot.classList.toggle('bg-primary', i === selected);
            dot.classList.toggle('bg-gray-300', i !== selected);
          });
        };

        dots.forEach((dot) => {
          dot.addEventListener('click', () => {
            manager.api.scrollTo(parseInt(dot.dataset.index ?? '0', 10));
          });
        });

        manager.api.on('select', updateDots);
        manager.api.on('init', updateDots);
        updateDots();
      }
    });
  };

  document.addEventListener('DOMContentLoaded', setupCarousels);
  document.addEventListener('astro:after-swap', setupCarousels);
</script>
